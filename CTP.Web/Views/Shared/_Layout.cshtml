@using CTP.Domain.Constants
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var __afTokens = Antiforgery.GetAndStoreTokens(Context);
    var systemName = "منصة التغيير والتحول";
    var systemSubtitle = "برنامج التغيير والتحول المؤسسي";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
    <style>
    /* Bootstrap Modal أعلى من SweetAlert2 */
    .modal-backdrop { z-index: 20000 !important; }
    .modal { z-index: 20010 !important; }
    .modal-dialog { z-index: 20020 !important; }
    
    /* في حال ظهور SweetAlert + Modal معاً، ارفع الـ Modal */
    body.swal2-shown .modal { z-index: 30000 !important; }
    body.swal2-shown .modal-backdrop { z-index: 29990 !important; }
</style>
<head>
   
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Security: CSRF Tokens for AJAX -->
    <meta name="csrf-token" content="@__afTokens.RequestToken" />
    <meta name="csrf-header" content="@__afTokens.HeaderName" />

    <link rel="icon" type="image/png" href="~/logo.png" />
    <title>@ViewData["Title"] - @systemName</title>

    <style>
            :root {
                --moda-section-accent: #C9A227;
                --ctp-primary-olive: #106981;
            }
    </style>

    <!-- Dependencies -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" />

    <!-- MODA Design System -->
    <link rel="stylesheet" href="~/css/moda-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/moda-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/moda-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/moda-legacy.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="moda-sidebar-overlay"></div>

    <div class="moda-page">
        <!-- Sidebar Navigation -->
        <aside class="moda-sidebar">
            <div class="moda-sidebar-header">
                <div class="moda-sidebar-logo">
                    <img src="~/logo.png" alt="@systemName" />
                </div>
                <h3 class="moda-sidebar-title">@systemName</h3>
                <p class="moda-sidebar-subtitle">@systemSubtitle</p>
            </div>

            <nav class="moda-sidebar-nav">
                @await Component.InvokeAsync("SidebarNavigation")
            </nav>

            <div class="moda-sidebar-footer">
                <div class="moda-sidebar-version">إصدار التدشين (UAT)</div>
            </div>
        </aside>

        <!-- Main Content Wrapper -->
        <div class="moda-main">
            <!-- Topbar -->
            <header class="moda-topbar">
                <div class="moda-topbar-right">
                    <button class="moda-sidebar-toggle" aria-label="فتح القائمة"><i class="bi bi-list"></i></button>
                    @{
                        var areaName = ViewContext.RouteData.Values["area"]?.ToString();
                        var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
                        var actionName = ViewContext.RouteData.Values["action"]?.ToString();

                        var areaDisplayNames = new Dictionary<string, string>
                        {
                            { "Core", "الرئيسية" },
                            { "Committee", "مركز الأعمال" },
                            { "Ambassador", "مساحة السفير" },
                            { "UnitLeader", "مساحة القيادة" },
                            { "Administration", "إدارة النظام" }
                        };

                        var areaDisplay = areaName != null && areaDisplayNames.ContainsKey(areaName)
                            ? areaDisplayNames[areaName]
                            : areaName ?? "الرئيسية";

                        var pageTitle = ViewData["Title"]?.ToString() ?? "";
                        var isHomePage = controllerName == "Home" && actionName == "Index";
                    }
                    <nav class="moda-breadcrumb" aria-label="مسار التنقل">
                        <a href="@Url.Action("Index", "Home", new { area = "" })" class="moda-breadcrumb-item">
                            <i class="bi bi-house-door-fill"></i>
                            <span>الرئيسية</span>
                        </a>
                        @if (!isHomePage && !string.IsNullOrEmpty(areaName) && areaName != "Core")
                        {
                            <span class="moda-breadcrumb-sep"><i class="bi bi-chevron-left"></i></span>
                            <span class="moda-breadcrumb-item">@areaDisplay</span>
                        }
                        @if (!isHomePage && !string.IsNullOrEmpty(pageTitle))
                        {
                            <span class="moda-breadcrumb-sep"><i class="bi bi-chevron-left"></i></span>
                            <span class="moda-breadcrumb-item moda-breadcrumb-current">@pageTitle</span>
                        }
                    </nav>
                </div>

                <div class="moda-topbar-date" id="topbarDate"></div>

                <div class="moda-topbar-left align-items-center d-flex gap-3">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="notification-dropdown-wrapper" style="position: relative;">
                            <a href="javascript:void(0);" class="moda-notification-bell text-decoration-none" id="notifDropdown">
                                <i class="bi bi-bell-fill"></i>
                                <span class="moda-notification-badge" id="notificationBadge" style="display:none;">0</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 animate-fade" id="notificationList" style="width: 340px; max-height: 400px; overflow-y: auto; border-radius: 12px; display: none; position: absolute; right: 0; top: 100%;">
                                <li><div class="dropdown-item text-center text-muted small py-4"><span class="spinner-border spinner-border-sm me-2"></span> جاري التحميل...</div></li>
                            </ul>
                        </div>
                    }

                    <!-- User Profile Dropdown -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="moda-user-dropdown dropdown">
                            <button class="btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="moda-user-avatar"><i class="bi bi-person"></i></div>
                                <div class="moda-user-info text-start">
                                    <span class="moda-user-name">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</span>
                                    @{
                                        var currentRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                                        var roleNameArabic = AppRolesHelper.GetArabicName(currentRole);
                                    }
                                    <span class="moda-user-role">@roleNameArabic</span>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown" style="border-radius: 12px;">
                                <li><a class="dropdown-item py-2" href="#"><i class="bi bi-person-circle me-2"></i> الملف الشخصي</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-area="" asp-controller="Account" asp-action="Logout" asp-antiforgery="true">
                                        <button type="submit" class="dropdown-item text-danger py-2"><i class="bi bi-box-arrow-right me-2"></i> تسجيل الخروج</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </header>

            <!-- Render Body -->
            <div class="moda-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Security: AJAX CSRF Interceptor -->
    <script>
            (function() {
                var meta = document.querySelector('meta[name="csrf-token"]');
                var hmeta = document.querySelector('meta[name="csrf-header"]');
                if (!meta || !hmeta) return;
                var token = meta.getAttribute('content');
                var header = hmeta.getAttribute('content');
                var safe = /^(GET|HEAD|OPTIONS|TRACE)$/i;

                function sameOrigin(url) {
                    try { return new URL(url, window.location.href).origin === window.location.origin; }
                    catch (e) { return true; }
                }

                if (window.jQuery) {
                    jQuery.ajaxSetup({
                        beforeSend: function(xhr, settings) {
                            if (!safe.test(settings.type || 'GET') && sameOrigin(settings.url)) {
                                xhr.setRequestHeader(header, token);
                            }
                        }
                    });
                }
            })();
    </script>

    <!-- UI Helpers & Utilities -->
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/moda-alerts.js" asp-append-version="true"></script>
    <script src="~/js/swal-helpers.js" asp-append-version="true"></script>
    <script src="~/js/moda-app.js" asp-append-version="true"></script>

    <!-- TempData Flash Messaging -->
    @if (TempData["Success"] != null)
    {
        <div data-flash-success="@TempData["Success"]" style="display:none"></div>
    }
    @if (TempData["Error"] != null)
    {
        <div data-flash-error="@TempData["Error"]" style="display:none"></div>
    }
    @if (TempData["Warning"] != null)
    {
        <div data-flash-warning="@TempData["Warning"]" style="display:none"></div>
    }
    @if (TempData["Info"] != null)
    {
        <div data-flash-info="@TempData["Info"]" style="display:none"></div>
    }

    <!-- System Scripts -->
    <script>
            // 1. Dynamic Notification Polling
            function loadNotifications() {
                $.get('/Notifications/GetMyNotifications', function(data) {
                    if (data && data.count > 0) {
                        $('#notificationBadge').text(data.count).show();
                        $('#notificationList').html(data.html);
                    } else {
                        $('#notificationBadge').hide();
                        $('#notificationList').html('<li><div class="dropdown-item text-center text-muted small py-4">لا توجد إشعارات جديدة</div></li>');
                    }
                }).fail(function() {
                    $('#notificationList').html('<li><div class="dropdown-item text-center text-danger small py-4">تعذر الاتصال بخادم الإشعارات</div></li>');
                });
            }

            $(document).ready(function() {
                var isAuthenticated = '@(User.Identity?.IsAuthenticated == true ? "true" : "false")' === 'true';
                if (isAuthenticated) {
                    loadNotifications();
                    setInterval(loadNotifications, 60000);
                }
            });

            // 2. Hijri / Gregorian Date Renderer
            (function() {
                var weekDays = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
                var gMonths = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'];
                var hMonths = ['محرم', 'صفر', 'ربيع الأول', 'ربيع الثاني', 'جمادى الأولى', 'جمادى الآخرة', 'رجب', 'شعبان', 'رمضان', 'شوال', 'ذو القعدة', 'ذو الحجة'];

                function toHijri(date) {
                    try {
                        var parts = new Intl.DateTimeFormat('en-US-u-ca-islamic-umalqura', { day: 'numeric', month: 'numeric', year: 'numeric' }).formatToParts(date);
                        var d = {};
                        parts.forEach(function(p) {
                            if (p.type === 'day') d.day = parseInt(p.value, 10);
                            else if (p.type === 'month') d.month = parseInt(p.value, 10);
                            else if (p.type === 'year') d.year = parseInt(p.value, 10);
                        });
                        return d;
                    } catch (e) { return null; }
                }

                function updateDate() {
                    var now = new Date();
                    var dayName = weekDays[now.getDay()];
                    var gDate = now.getDate() + ' ' + gMonths[now.getMonth()] + ' ' + now.getFullYear() + ' م';
                    var h = toHijri(now);
                    var hDate = h ? (h.day + ' ' + hMonths[h.month - 1] + ' ' + h.year + ' هـ') : '';
                    var el = document.getElementById('topbarDate');
                    if (el) {
                        el.innerHTML = '<i class="bi bi-calendar3"></i> ' +
                            '<span class="moda-date-hijri">' + dayName + (hDate ? ' ' + hDate : '') + '</span>' +
                            '<span class="moda-date-separator">—</span>' +
                            '<span class="moda-date-gregorian">' + gDate + '</span>';
                    }
                }
                updateDate();
            })();
            document.addEventListener("DOMContentLoaded", function() {
                const wrapper = document.querySelector('.notification-dropdown-wrapper');
                const menu = document.getElementById('notificationList');
                const badge = document.getElementById('notificationBadge');

                if (wrapper && menu) {
                    let timeout;
                    let isMarkingAsRead = false; // مفتاح الأمان لمنع تجميد قاعدة البيانات (SQLite Lock)

                    // إظهار القائمة عند تمرير المؤشر
                    wrapper.addEventListener('mouseenter', function() {
                        clearTimeout(timeout);
                        menu.style.display = 'block';

                        // التحقق من وجود إشعارات وعدم وجود طلب قيد التنفيذ
                        if (badge.style.display !== 'none' && badge.textContent.trim() !== '0' && !isMarkingAsRead) {
                            isMarkingAsRead = true; // إغلاق المفتاح فوراً

                            $.post('/Notifications/MarkAsRead', function() {
                                badge.style.display = 'none';
                                badge.textContent = '0';
                            }).fail(function() {
                                isMarkingAsRead = false; // إعادة فتح المفتاح فقط في حال فشل الخادم
                                console.error("تعذر تحديث حالة الإشعارات.");
                            });
                        }
                    });

                    // إخفاء القائمة عند إبعاد المؤشر
                    wrapper.addEventListener('mouseleave', function() {
                        timeout = setTimeout(function() {
                            menu.style.display = 'none';
                        }, 250); // مهلة ربع ثانية لحركة سلسة
                    });
                }
            });

            // دالة تصفير العداد وإخفاء العلامة الحمراء برمجياً
            function markNotificationsAsRead() {
                $.post('/Notifications/MarkAsRead', function() {
                    const badge = document.getElementById('notificationBadge');
                    if (badge) {
                        badge.style.display = 'none';
                        badge.textContent = '0';
                    }
                }).fail(function() {
                    console.error("فشل تحديث حالة قراءة الإشعارات.");
                });
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>