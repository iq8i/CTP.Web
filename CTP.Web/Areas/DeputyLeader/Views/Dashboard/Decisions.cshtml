@model CTP.Web.Areas.DeputyLeader.Models.DeputyDashboardViewModel
@{
    Layout = "_Layout";
}

<partial name="~/Views/Shared/_EntityDashboardHeader.cshtml" />

<div class="container-fluid mt-4 mb-5">

    <div class="mb-3">
        <a asp-action="Index" class="moda-btn moda-btn-outline">
            <i class="bi bi-arrow-right me-1"></i> عودة للملخص التنفيذي
        </a>
    </div>

    <div class="moda-card border-0 shadow-sm">
        <div class="moda-card-header d-flex justify-content-between align-items-center">
            <h5 class="moda-card-title mb-0">
                <i class="bi bi-shield-exclamation me-2"></i> قرارات الدعم المطلوبة
            </h5>
            <span class="badge bg-danger px-3 py-2">@Model.SupportDecisions.Count قرار</span>
        </div>
        <div class="moda-card-body p-4">
            @if (Model.SupportDecisions.Any())
            {
                foreach (var dec in Model.SupportDecisions)
                {
                    <div class="p-4 mb-3 rounded" style="background: #FEF2F2; border-right: 4px solid #9C3D2E;">
                        <h6 class="fw-bold mb-2" style="color: #073B49;">@dec.Title</h6>
                        <div class="row g-2 small text-muted">
                            <div class="col-md-4">
                                <i class="bi bi-building me-1"></i>
                                <strong>الجهة:</strong> @dec.Entity
                            </div>
                            <div class="col-md-4">
                                <i class="bi bi-person me-1"></i>
                                <strong>مقدم الطلب:</strong> @dec.RequestedBy
                            </div>
                            <div class="col-md-4">
                                <i class="bi bi-bullseye me-1"></i>
                                <strong>الأثر المتوقع:</strong> @dec.ExpectedImpact
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-check-circle fs-1 d-block mb-3 text-success"></i>
                    <h5>لا توجد قرارات دعم مطلوبة حالياً</h5>
                    <p class="small">جميع التوصيات معالجة ضمن صلاحيات الجهات.</p>
                </div>
            }
        </div>
    </div>

</div>