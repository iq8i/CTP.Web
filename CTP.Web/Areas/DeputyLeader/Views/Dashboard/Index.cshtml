@model CTP.Web.Areas.DeputyLeader.Models.DeputyDashboardViewModel
@{
    Layout = "_Layout";
}

@section Styles {
    <style>
        .hero-banner {
            background: linear-gradient(135deg, #073B49 0%, #0B4F61 50%, #2E86A0 100%);
            color: white;
            padding: 32px 36px;
            border-radius: 18px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(7, 59, 73, 0.25);
        }

            .hero-banner::after {
                content: "";
                position: absolute;
                top: -50px;
                inset-inline-end: -50px;
                width: 300px;
                height: 300px;
                background: radial-gradient(circle, rgba(201, 162, 39, 0.18), transparent 70%);
                pointer-events: none;
            }

            .hero-banner h1 {
                font-size: 1.8rem;
                font-weight: 800;
                margin-bottom: 8px;
            }

            .hero-banner .hero-sub {
                opacity: 0.9;
                font-size: 1rem;
                margin-bottom: 20px;
            }

        .hero-stats {
            display: flex;
            gap: 32px;
            flex-wrap: wrap;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
        }

        .hero-stat {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .hero-stat .hero-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: rgba(255, 255, 255, 0.12);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.3rem;
                color: #E6D39A;
            }

            .hero-stat .hero-num {
                font-size: 1.6rem;
                font-weight: 800;
                line-height: 1.1;
            }

            .hero-stat .hero-lbl {
                font-size: 0.75rem;
                opacity: 0.8;
            }

        .kpi-card {
            background: #FFFFFF;
            border: 1px solid #D6E5EA;
            border-radius: 14px;
            padding: 20px;
            height: 100%;
            box-shadow: 0 4px 12px rgba(7, 59, 73, 0.06);
            transition: transform 0.2s;
        }

            .kpi-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(7, 59, 73, 0.1);
            }

        .summary-box {
            background: linear-gradient(135deg, #FEFCF3 0%, #FFFFFF 100%);
            border: 1px solid rgba(201, 162, 39, 0.4);
            border-right: 4px solid #C9A227;
            border-radius: 14px;
            padding: 24px;
            line-height: 1.9;
            font-size: 0.95rem;
            color: #334155;
        }

        .metric-bar {
            margin-bottom: 16px;
        }

            .metric-bar .metric-row {
                display: flex;
                justify-content: space-between;
                font-size: 0.9rem;
                margin-bottom: 6px;
                font-weight: 600;
            }

            .metric-bar .progress {
                height: 12px;
                border-radius: 10px;
                background: #EAF2F4;
            }

        .rec-mini {
            border-right: 3px solid #C9A227;
            background: #FDF9EC;
            border-radius: 8px;
            padding: 10px 14px;
            margin-bottom: 8px;
        }

            .rec-mini .rec-num {
                font-size: 0.72rem;
                color: #8A6A12;
                font-weight: 700;
                margin-bottom: 4px;
            }

            .rec-mini .rec-action {
                font-size: 0.83rem;
                color: #073B49;
                line-height: 1.5;
            }

        .decision-card {
            background: #FEF2F2;
            border-right: 4px solid #9C3D2E;
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 10px;
        }

            .decision-card .dec-title {
                font-weight: 700;
                color: #073B49;
                font-size: 0.88rem;
                margin-bottom: 6px;
            }

            .decision-card .dec-meta {
                font-size: 0.73rem;
                color: #537382;
            }

        .impact-mini {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 12px;
            align-items: center;
            padding: 10px 12px;
            background: #F8FAFC;
            border-radius: 10px;
            margin-bottom: 8px;
            font-size: 0.85rem;
        }

            .impact-mini .impact-arrow {
                color: #C9A227;
                font-size: 1.2rem;
            }

        .plan-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .plan-list li {
                padding: 10px 14px;
                background: #F8FAFC;
                border-radius: 8px;
                margin-bottom: 8px;
                display: flex;
                gap: 10px;
                align-items: flex-start;
                font-size: 0.88rem;
                line-height: 1.6;
            }

                .plan-list li::before {
                    content: "";
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: #C9A227;
                    flex-shrink: 0;
                    margin-top: 8px;
                }

        .view-all-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            font-size: 0.8rem;
            font-weight: 600;
            color: #0B4F61;
            background: linear-gradient(145deg, #F8FAFC, #EAF2F4);
            border: 1px solid #D6E5EA;
            border-radius: 20px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .view-all-btn:hover {
                background: linear-gradient(145deg, #EAF2F4, #D6E5EA);
                border-color: #106981;
                color: #106981;
                transform: translateY(-1px);
            }
    </style>
}

<partial name="~/Views/Shared/_EntityDashboardHeader.cshtml" />

<div class="container-fluid mt-4 mb-5">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Hero Banner                                         -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="hero-banner">
        <h1>مرحباً سعادة النائب</h1>
        <p class="hero-sub">الملخص التنفيذي الشهري — @Model.CurrentMonth</p>

        <div class="hero-stats">
            <div class="hero-stat">
                <div class="hero-icon"><i class="bi bi-file-earmark-text"></i></div>
                <div>
                    <div class="hero-num">@Model.ApprovedReports</div>
                    <div class="hero-lbl">تقرير معتمد</div>
                </div>
            </div>
            <div class="hero-stat">
                <div class="hero-icon"><i class="bi bi-speedometer2"></i></div>
                <div>
                    <div class="hero-num">@Model.AvgReadiness%</div>
                    <div class="hero-lbl">الجاهزية</div>
                </div>
            </div>
            <div class="hero-stat">
                <div class="hero-icon"><i class="bi bi-graph-up-arrow"></i></div>
                <div>
                    <div class="hero-num">@Model.AvgAdoption%</div>
                    <div class="hero-lbl">التبني</div>
                </div>
            </div>
            <div class="hero-stat">
                <div class="hero-icon"><i class="bi bi-shield-exclamation"></i></div>
                <div>
                    <div class="hero-num">@Model.PendingDecisions</div>
                    <div class="hero-lbl">قرار دعم معلّق</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Row 1: الملخص الشهري + مؤشرات                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="row g-4 mb-4">

        <div class="col-lg-8">
            <div class="kpi-card h-100">
                <h6 class="fw-bold mb-3" style="color: var(--ctp-primary-olive);">
                    <i class="bi bi-file-text me-2"></i> الملخص التنفيذي الشهري (بعد الاعتماد)
                </h6>
                <div class="summary-box">
                    @Model.MonthlySummary
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="kpi-card h-100">
                <h6 class="fw-bold mb-3" style="color: var(--ctp-primary-olive);">
                    <i class="bi bi-bar-chart-steps me-2"></i> مؤشرات الجاهزية والتبني
                </h6>

                @{
                    var metrics = new[]
                    {
                        ("الجاهزية", Model.ReadinessCurrent),
                        ("التبني", Model.AdoptionCurrent),
                        ("التعزيز", Model.ReinforcementCurrent)
                    };
                }

                @foreach (var m in metrics)
                {
                    var val = (int)m.Item2;
                    var cls = val < 50 ? "bg-danger" : val < 65 ? "bg-warning" : "bg-success";
                    <div class="metric-bar">
                        <div class="metric-row">
                            <span>@m.Item1</span>
                            <span>@m.Item2%</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar @cls" style="width: @val%"></div>
                        </div>
                    </div>
                }

                <div class="alert alert-info small border-0 mb-0 mt-3" style="background: #F8FAFC;">
                    <i class="bi bi-info-circle me-1"></i>
                    المؤشرات محسوبة على التقارير المعتمدة فقط.
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Row 2: التوصيات + قرارات الدعم                       -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="row g-4 mb-4">

        <!-- التوصيات المعتمدة -->
        <div class="col-lg-6">
            <div class="kpi-card h-100">
                <h6 class="fw-bold mb-3" style="color: var(--ctp-primary-olive);">
                    <i class="bi bi-journal-check me-2"></i> التوصيات المعتمدة
                    <span class="badge bg-success ms-2">@Model.ApprovedRecommendations</span>
                </h6>

                @if (Model.ApprovedRecommendationsList.Any())
                {
                    @foreach (var rec in Model.ApprovedRecommendationsList)
                    {
                        <div class="rec-mini">
                            <div class="rec-num">
                                @rec.RecommendationNumber — @rec.EntityName
                            </div>
                            <div class="rec-action">
                                @(rec.SuggestedAction.Length > 110 ? rec.SuggestedAction.Substring(0, 110) + "..." : rec.SuggestedAction)
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        <small>لا توجد توصيات معتمدة بعد</small>
                    </div>
                }
            </div>
        </div>

        <!-- قرارات الدعم -->
        <div class="col-lg-6">
            <div class="kpi-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h6 class="fw-bold mb-0" style="color: var(--ctp-primary-olive);">
                        <i class="bi bi-shield-exclamation me-2"></i> قرارات الدعم المطلوبة
                    </h6>
                    @if (Model.SupportDecisions.Any())
                    {
                        <a asp-action="Decisions" class="view-all-btn">
                            عرض الكل <i class="bi bi-arrow-left"></i>
                        </a>
                    }
                </div>

                @if (Model.SupportDecisions.Any())
                {
                    @foreach (var dec in Model.SupportDecisions)
                    {
                        <div class="decision-card">
                            <div class="dec-title">
                                @(dec.Title.Length > 100 ? dec.Title.Substring(0, 100) + "..." : dec.Title)
                            </div>
                            <div class="dec-meta">
                                <i class="bi bi-building me-1"></i>@dec.Entity
                                <span class="mx-2">|</span>
                                <i class="bi bi-person me-1"></i>@dec.RequestedBy
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
                        <small>لا توجد قرارات دعم مطلوبة</small>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Row 3: الأثر + خطة الشهر القادم                      -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div class="row g-4">

        <!-- الأثر المتحقق -->
        <div class="col-lg-6">
            <div class="kpi-card h-100">
                <h6 class="fw-bold mb-3" style="color: var(--ctp-primary-olive);">
                    <i class="bi bi-graph-up me-2"></i> الأثر المتحقق
                </h6>

                @if (Model.TopImpacts.Any())
                {
                    @foreach (var impact in Model.TopImpacts)
                    {
                        <div class="impact-mini">
                            <div>
                                <div class="text-muted" style="font-size: 0.7rem;">قبل</div>
                                <div class="fw-bold" style="color: #537382;">@impact.Before%</div>
                            </div>
                            <div class="impact-arrow"><i class="bi bi-arrow-left"></i></div>
                            <div>
                                <div class="text-muted" style="font-size: 0.7rem;">بعد</div>
                                <div class="fw-bold" style="color: #3E7C3E;">@impact.After%</div>
                            </div>
                        </div>
                    }

                    <div class="alert alert-success small border-0 mb-0 mt-3">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        <strong>@Model.ImpactVerifiedCount مؤشرات تحققت</strong> بمتوسط +@Model.AvgImpactDelta نقطة
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-hourglass fs-1 d-block mb-2"></i>
                        <small>الأثر قيد القياس</small>
                    </div>
                }
            </div>
        </div>

        <!-- خطة الشهر القادم -->
        <div class="col-lg-6">
            <div class="kpi-card h-100">
                <h6 class="fw-bold mb-3" style="color: var(--ctp-primary-olive);">
                    <i class="bi bi-calendar-check me-2"></i> خطة الشهر القادم
                </h6>

                <ul class="plan-list">
                    @foreach (var item in Model.NextMonthPlan)
                    {
                        <li>@item</li>
                    }
                </ul>
            </div>
        </div>
    </div>

</div>