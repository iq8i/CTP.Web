@model CTP.Web.Areas.Committee.Models.ChairBoardViewModel
@{
    Layout = "_Layout";
}

<partial name="~/Views/Shared/_EntityDashboardHeader.cshtml" />

<div class="container-fluid mt-4 mb-5">
    <div class="moda-card border-0 shadow-sm mb-4">
        <div class="moda-card-header d-flex justify-content-between align-items-center">
            <h5 class="moda-card-title mb-0">
                <i class="bi bi-hourglass-split me-2"></i> التوصيات بانتظار الاعتماد
            </h5>
            <span class="badge bg-warning text-dark px-3 py-2">@((Model?.PendingRecommendations?.Count) ?? 0) توصية</span>
        </div>
        <div class="moda-card-body p-0">
            <div class="table-responsive">
                <table class="moda-table text-center align-middle mb-0">
                    <thead>
                        <tr>
                            <th>رقم التقرير</th>
                            <th>الجهة</th>
                            <th>اسم التغيير</th>
                            <th>الحالة</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.PendingRecommendations != null && Model.PendingRecommendations.Any())
                        {
                            foreach (var item in Model.PendingRecommendations)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@(item.SourceReport?.ReportNumber ?? item.MonthlyReportId.ToString())</td>
                                    <td><span class="badge bg-light text-dark border">@(item.SourceReport?.Organization?.EntityName ?? "غير متوفر")</span></td>
                                    <td class="text-start">@(item.SourceReport?.ChangeName ?? "غير متوفر")</td>
                                    <td><span class="badge bg-warning text-dark px-3 py-2">@item.Status</span></td>
                                    <td>
                                        <a asp-action="ChairReview" asp-route-reportId="@item.MonthlyReportId" class="moda-btn moda-btn-sm moda-btn-gold">
                                            <i class="bi bi-eye me-1"></i> اعتماد / إرجاع
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="py-4 text-muted">لا توجد توصيات بانتظار الاعتماد حالياً.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="moda-card border-0 shadow-sm">
        <div class="moda-card-header d-flex justify-content-between align-items-center">
            <h5 class="moda-card-title mb-0">
                <i class="bi bi-shield-check me-2"></i> التوصيات المعتمدة
            </h5>
            <span class="badge bg-secondary px-3 py-2">@((Model?.ApprovedRecommendations?.Count) ?? 0) توصية</span>
        </div>
        <div class="moda-card-body p-0">
            <div class="table-responsive">
                <table class="moda-table text-center align-middle mb-0">
                    <thead>
                        <tr>
                            <th>رقم التقرير</th>
                            <th>الجهة</th>
                            <th>اسم التغيير</th>
                            <th>وجهات الإدراج</th>
                            <th>تاريخ الاعتماد</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.ApprovedRecommendations != null && Model.ApprovedRecommendations.Any())
                        {
                            foreach (var item in Model.ApprovedRecommendations)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@(item.SourceReport?.ReportNumber ?? item.MonthlyReportId.ToString())</td>
                                    <td><span class="badge bg-light text-dark border">@(item.SourceReport?.Organization?.EntityName ?? "غير متوفر")</span></td>
                                    <td class="text-start">@(item.SourceReport?.ChangeName ?? "غير متوفر")</td>
                                    <td class="text-start small">
                                        <div class="d-flex flex-wrap gap-1 justify-content-center">
                                            @if (item.IncludeInInstitutionalReport)
                                            {
                                                <span class="badge bg-primary-subtle text-primary border">التقرير الشهري</span>
                                            }
                                            @if (item.IncludeInImpactDashboard)
                                            {
                                                <span class="badge bg-success-subtle text-success border">لوحة الأثر</span>
                                            }
                                            @if (item.IncludeInExecutiveSummary)
                                            {
                                                <span class="badge bg-warning-subtle text-dark border">الملخص التنفيذي</span>
                                            }
                                            @if (!item.IncludeInInstitutionalReport && !item.IncludeInImpactDashboard && !item.IncludeInExecutiveSummary)
                                            {
                                                <span class="text-muted">لم يتم الإدراج بعد</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="small text-muted">@(item.ReviewedDate?.ToString("yyyy/MM/dd") ?? item.CreatedDate.ToString("yyyy/MM/dd"))</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                                            <form method="post" asp-action="UpdateRecommendationPlacement" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reportId" value="@item.MonthlyReportId" />
                                                <input type="hidden" name="placement" value="institutional" />
                                                <input type="hidden" name="enabled" value="@(item.IncludeInInstitutionalReport ? "false" : "true")" />
                                                <button type="submit" class="btn btn-sm @(item.IncludeInInstitutionalReport ? "btn-success" : "btn-outline-primary")">
                                                    <i class="bi @(item.IncludeInInstitutionalReport ? "bi-check-circle-fill" : "bi-journal-text") me-1"></i>@(item.IncludeInInstitutionalReport ? "مدرج في الشهري" : "إدراج في الشهري")
                                                </button>
                                            </form>

                                            <form method="post" asp-action="UpdateRecommendationPlacement" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reportId" value="@item.MonthlyReportId" />
                                                <input type="hidden" name="placement" value="impact" />
                                                <input type="hidden" name="enabled" value="@(item.IncludeInImpactDashboard ? "false" : "true")" />
                                                <button type="submit" class="btn btn-sm @(item.IncludeInImpactDashboard ? "btn-success" : "btn-outline-success")">
                                                    <i class="bi @(item.IncludeInImpactDashboard ? "bi-check-circle-fill" : "bi-graph-up-arrow") me-1"></i>@(item.IncludeInImpactDashboard ? "مدرج في الأثر" : "إدراج في الأثر")
                                                </button>
                                            </form>

                                            <form method="post" asp-action="UpdateRecommendationPlacement" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reportId" value="@item.MonthlyReportId" />
                                                <input type="hidden" name="placement" value="executive" />
                                                <input type="hidden" name="enabled" value="@(item.IncludeInExecutiveSummary ? "false" : "true")" />
                                                <button type="submit" class="btn btn-sm @(item.IncludeInExecutiveSummary ? "btn-success" : "btn-outline-warning")">
                                                    <i class="bi @(item.IncludeInExecutiveSummary ? "bi-check-circle-fill" : "bi-file-earmark-text") me-1"></i>@(item.IncludeInExecutiveSummary ? "مدرج في التنفيذي" : "إدراج في التنفيذي")
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="py-5 text-muted">
                                    <i class="bi bi-folder2-open fs-2 d-block mb-2"></i>
                                    لا توجد توصيات معتمدة حالياً في منصة الاعتماد.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
