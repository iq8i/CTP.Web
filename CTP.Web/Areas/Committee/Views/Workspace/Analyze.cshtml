@model CTP.Web.Areas.Committee.Models.AnalyzeReportViewModel
@{
    Layout = "_Layout";
}

<partial name="~/Views/Shared/_EntityDashboardHeader.cshtml" />

<div class="container-fluid mt-4 mb-5">
    <div class="row g-4">

        <!-- التشخيص الآلي (ADKAR) -->
        <div class="col-lg-4">
            <div class="moda-card border-0 shadow-sm p-4 h-100 bg-light">
                <h6 class="fw-bold text-dark mb-4">
                    <i class="bi bi-heart-pulse text-danger me-2"></i> التشخيص الآلي (ADKAR)
                </h6>

                @{
                    var adkar = new Dictionary<string, int>
                    {
                        { "الوعي (Awareness)", Model.ReportDetails?.AdkarAwareness ?? 0 },
                        { "الرغبة (Desire)", Model.ReportDetails?.AdkarDesire ?? 0 },
                        { "المعرفة (Knowledge)", Model.ReportDetails?.AdkarKnowledge ?? 0 },
                        { "القدرة (Ability)", Model.ReportDetails?.AdkarAbility ?? 0 },
                        { "التعزيز (Reinforcement)", Model.ReportDetails?.AdkarReinforcement ?? 0 }
                    };

                    var barrier = adkar.OrderBy(x => x.Value).FirstOrDefault();
                }

                @foreach (var item in adkar)
                {
                    <div class="mb-2 small fw-bold d-flex justify-content-between">
                        <span>@item.Key</span>
                        <span>@item.Value%</span>
                    </div>
                    <div class="progress mb-3" style="height: 8px;">
                        <div class="progress-bar @(item.Key == barrier.Key ? "bg-danger" : "bg-primary")"
                             style="width: @item.Value%"></div>
                    </div>
                }

                <div class="alert alert-danger mt-4 small border-0 shadow-sm">
                    نقطة الحاجز الآلية: <strong>@barrier.Key</strong> (@barrier.Value%)
                </div>

                <div class="alert alert-warning small border-0 shadow-sm">
                    عائق التبني المرفوع من الجهة:
                    <br />
                    <strong>@(string.IsNullOrEmpty(Model.ReportDetails?.AdoptionBarriers) ? "لم يُرفع عائق محدد" : Model.ReportDetails.AdoptionBarriers)</strong>
                </div>
            </div>
        </div>

        <!-- صياغة القرار والتوصية -->
        <div class="col-lg-8">
            <div class="moda-card border-0 shadow-sm p-4 h-100" style="border-right: 4px solid var(--moda-section-accent) !important; background-color: #FDF9EC;">
                <h5 class="fw-bold mb-4"><i class="bi bi-hammer me-2 text-warning"></i> صياغة القرار والتوصية</h5>

                <form method="post" asp-action="Analyze">
                    <input type="hidden" asp-for="MonthlyReportId" value="@Model.MonthlyReportId" />

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-dark">التشخيص الجذري للمشكلة المرفوعة (Root Cause)</label>
                        <textarea asp-for="WhatHappened" class="form-control border-0 shadow-sm p-3" rows="2" required></textarea>
                        <span asp-validation-for="WhatHappened" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-dark">لماذا تشكل هذه الفجوة خطراً؟ (So What)</label>
                        <textarea asp-for="WhyItMatters" class="form-control border-0 shadow-sm p-3" rows="2" required></textarea>
                        <span asp-validation-for="WhyItMatters" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-dark">التدخل أو الإجراء التصحيحي (Now What)</label>
                        <textarea asp-for="WhatNow" class="form-control border-0 shadow-sm p-3" rows="2" required></textarea>
                        <span asp-validation-for="WhatNow" class="text-danger small"></span>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">خلاصة التوصية (ستُحفظ في السجل الرسمي)</label>
                            <input type="text" asp-for="SuggestedAction" class="form-control border-0 shadow-sm p-3 fw-bold text-primary" required />
                            <span asp-validation-for="SuggestedAction" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">الأثر المتوقع</label>
                            <input type="text" asp-for="ExpectedImpact" class="form-control border-0 shadow-sm p-3" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">الجهة المالكة للحل</label>
                            <input type="text" asp-for="Owner" class="form-control border-0 shadow-sm p-2" required />
                            <span asp-validation-for="Owner" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">مستوى الأولوية</label>
                            <select asp-for="Priority" class="form-select border-0 shadow-sm p-2">
                                <option value="عالية جداً">عالية جداً</option>
                                <option value="عالية">عالية</option>
                                <option value="متوسطة" selected>متوسطة</option>
                                <option value="منخفضة">منخفضة</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top pt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="RequiresSupport" id="RequiresSupport">
                            <label class="form-check-label fw-bold text-danger small ms-2" for="RequiresSupport">
                                يُرفع كطلب دعم قيادي / سيادي
                            </label>
                        </div>
                        <div>
                            <a asp-action="Inbox" class="moda-btn moda-btn-outline me-2 px-4">إلغاء</a>
                            <button type="submit" class="moda-btn moda-btn-gold px-4 fw-bold">
                                <i class="bi bi-send me-1"></i> إرسال التوصية لرئيس اللجنة
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}