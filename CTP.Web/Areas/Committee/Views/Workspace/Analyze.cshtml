@model CTP.Web.Areas.Committee.Models.AnalyzeReportViewModel
@{
    Layout = "_Layout";
}

<partial name="~/Views/Shared/_EntityDashboardHeader.cshtml" />

<div class="container-fluid mt-4 mb-5">

    <!-- معلومات التقرير المستهدف -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-3 bg-white rounded border d-flex justify-content-between align-items-center shadow-sm">
                <div>
                    <h6 class="text-muted mb-1 small">الجهة</h6>
                    <h5 class="fw-bold mb-0" style="color: var(--ctp-primary-olive);">@(Model.ReportDetails.Organization?.EntityName)</h5>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small">اسم التغيير</h6>
                    <span class="fw-bold text-dark">@Model.ReportDetails.ChangeName</span>
                </div>
                <div class="text-center">
                    <h6 class="text-muted mb-1 small">الجاهزية / التبني</h6>
                    <span class="text-primary fw-bold">@Model.ReportDetails.ReadinessScore%</span> / <span class="text-success fw-bold">@Model.ReportDetails.AdoptionScore%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- نموذج التحليل المستقل -->
    <div class="moda-card border-0 shadow-sm p-4">
        <h5 class="fw-bold mb-4" style="color: var(--ctp-primary-olive);">
            <i class="bi bi-diagram-2-fill me-2 text-warning"></i> خلاصة القرار (What / So What / Now What)
        </h5>

        <form method="post" asp-action="Analyze">
            <input type="hidden" asp-for="MonthlyReportId" />

            <div class="row g-4">
                <div class="col-md-12">
                    <label class="form-label fw-bold" style="color: var(--ctp-primary-olive);">ماذا حدث؟ (What)</label>
                    <textarea asp-for="WhatHappened" class="form-control bg-light border-0 shadow-none" rows="2" placeholder="الحدث أو الملاحظة الأساسية من التقرير..." required></textarea>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-bold" style="color: var(--ctp-primary-olive);">لماذا يهم؟ (So What - نوع الفجوة)</label>
                    <textarea asp-for="WhyItMatters" class="form-control border-warning-subtle shadow-none" rows="2" placeholder="تأثير الفجوة والمخاطر..." required></textarea>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-bold" style="color: var(--ctp-primary-olive);">ماذا نفعل الآن؟ (Now What - التدخل)</label>
                    <textarea asp-for="WhatNow" class="form-control bg-light border-0 shadow-none" rows="2" placeholder="الإجراء التصحيحي المطلوب تنفيذه..." required></textarea>
                </div>

                <hr class="my-4 text-muted" />

                <div class="col-md-4">
                    <label class="form-label fw-bold text-dark small">الإجراء المقترح (للسجل الرسمي)</label>
                    <input type="text" asp-for="SuggestedAction" class="form-control border-0 bg-light shadow-none" placeholder="خلاصة الإجراء لتسجيله كقرار..." required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-dark small">الأثر المتوقع للمؤشر</label>
                    <input type="text" asp-for="ExpectedImpact" class="form-control border-0 bg-light shadow-none" placeholder="مثال: رفع الجاهزية 10 نقاط..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-dark small">الجهة المالكة للحل</label>
                    <input type="text" asp-for="Owner" class="form-control border-0 bg-light shadow-none" placeholder="ممثل الجهة أو الإدارة..." />
                </div>

                <div class="col-md-12 mt-4 d-flex justify-content-between align-items-center bg-light p-3 rounded">
                    <div class="form-check form-switch">
                        <input class="form-check-input shadow-none" type="checkbox" asp-for="RequiresSupport" style="transform: scale(1.2);">
                        <label class="form-check-label ms-2 fw-bold text-danger" for="RequiresSupport">يُرفع للقيادة (يحتاج قرار سيادي / تصعيد)</label>
                    </div>

                    <div>
                        <a asp-action="Inbox" class="moda-btn moda-btn-outline me-2">إلغاء</a>
                        <button type="submit" class="moda-btn moda-btn-gold px-4">
                            <i class="bi bi-save me-2"></i> حفظ وتوليد التوصية
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}