@model CTP.Domain.Entities.Recommendation
@{
    Layout = "_Layout";
    var report = Model.SourceReport;
}

<partial name="~/Views/Shared/_EntityDashboardHeader.cshtml" />

<div class="container-fluid mt-4 mb-5">
    <div class="moda-card border-0 shadow-sm p-4">
        <div class="row border-bottom pb-3 mb-4">
            <div class="col-md-6">
                <h6 class="text-muted mb-1">رقم التقرير</h6>
                <h4 class="fw-bold" style="color: var(--ctp-primary-olive);">@(report?.ReportNumber ?? "غير متوفر")</h4>
                <div class="text-muted small">@(report?.Organization?.EntityName ?? "")</div>
            </div>
            <div class="col-md-3">
                <h6 class="text-muted mb-1">اسم التغيير</h6>
                <span class="fw-bold text-dark">@(report?.ChangeName ?? "غير متوفر")</span>
            </div>
            <div class="col-md-3">
                <h6 class="text-muted mb-1">مرحلة التغيير</h6>
                <span class="badge bg-secondary px-3 py-2">@(report?.CurrentStage ?? "-")</span>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <h6 class="fw-bold mb-3" style="color: var(--ctp-primary-olive);"><i class="bi bi-file-text me-2"></i> تفاصيل التقرير بالكامل</h6>

                <div class="mb-3 p-3 bg-light rounded border">
                    <h6 class="text-muted fw-bold small">ملخص التغيير</h6>
                    <p class="mb-0 text-dark">@(string.IsNullOrEmpty(report?.ChangeSummary) ? "لا يوجد ملخص" : report?.ChangeSummary)</p>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="text-muted fw-bold small">لماذا هذا التغيير مهم؟</h6>
                            <p class="mb-0 small text-dark">@(string.IsNullOrEmpty(report?.WhyImportant) ? "-" : report?.WhyImportant)</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="text-muted fw-bold small">ماذا سيتغير؟</h6>
                            <p class="mb-0 small text-dark">@(string.IsNullOrEmpty(report?.WhatWillChange) ? "-" : report?.WhatWillChange)</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="text-muted fw-bold small">ماذا لن يتغير؟</h6>
                            <p class="mb-0 small text-dark">@(string.IsNullOrEmpty(report?.WhatWillNotChange) ? "-" : report?.WhatWillNotChange)</p>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="card bg-light border-0 h-100">
                            <div class="card-body">
                                <h6 class="text-muted fw-bold mb-3"><i class="bi bi-bar-chart-steps"></i> مؤشرات ADKAR</h6>
                                <div class="d-flex justify-content-between mb-2"><span>الوعي (A)</span> <strong>@report?.AdkarAwareness%</strong></div>
                                <div class="d-flex justify-content-between mb-2"><span>الرغبة (D)</span> <strong>@report?.AdkarDesire%</strong></div>
                                <div class="d-flex justify-content-between mb-2"><span>المعرفة (K)</span> <strong>@report?.AdkarKnowledge%</strong></div>
                                <div class="d-flex justify-content-between mb-2"><span>القدرة (A)</span> <strong>@report?.AdkarAbility%</strong></div>
                                <div class="d-flex justify-content-between"><span>التعزيز (R)</span> <strong>@report?.AdkarReinforcement%</strong></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card bg-light border-0 h-100">
                            <div class="card-body text-center d-flex flex-column justify-content-center">
                                <div class="row">
                                    <div class="col-6">
                                        <h2 class="text-primary fw-bold mb-0">@report?.ReadinessScore%</h2>
                                        <span class="text-muted small">مؤشر الجاهزية</span>
                                    </div>
                                    <div class="col-6">
                                        <h2 class="text-success fw-bold mb-0">@report?.AdoptionScore%</h2>
                                        <span class="text-muted small">مؤشر التبني</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-white rounded border border-danger-subtle h-100">
                            <h6 class="text-danger fw-bold small">العوائق والتحديات التشغيلية</h6>
                            <p class="mb-0 small">@(string.IsNullOrEmpty(report?.Obstacles) ? "-" : report?.Obstacles)</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-white rounded border border-warning-subtle h-100">
                            <h6 class="text-warning fw-bold small">عوائق التبني للفئات المتأثرة</h6>
                            <p class="mb-0 small">@(string.IsNullOrEmpty(report?.AdoptionBarriers) ? "-" : report?.AdoptionBarriers)</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-white rounded border border-info-subtle h-100">
                            <h6 class="text-info fw-bold small">الدعم المطلوب للجهة</h6>
                            <p class="mb-0 small">@(string.IsNullOrEmpty(report?.RequiredSupport) ? "-" : report?.RequiredSupport)</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-white rounded border border-primary-subtle h-100">
                            <h6 class="text-primary fw-bold small">التوصية الأولية من الجهة</h6>
                            <p class="mb-0 small">@(string.IsNullOrEmpty(report?.InitialRecommendation) ? "-" : report?.InitialRecommendation)</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <h6 class="fw-bold mb-3" style="color: var(--ctp-primary-olive);"><i class="bi bi-journal-text me-2"></i> التوصية التي ستعتمد</h6>
                <div class="p-3 rounded border bg-light mb-3">
                    <div class="mb-2">
                        <span class="text-muted small">رقم التوصية</span>
                        <div class="fw-bold">@Model.RecommendationNumber</div>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small">نوع الفجوة</span>
                        <div class="fw-bold">@Model.GapType</div>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small">الإجراء المقترح</span>
                        <div>@Model.SuggestedAction</div>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small">مالك الإجراء</span>
                        <div>@Model.ActionOwner</div>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small">المدة</span>
                        <div>@Model.Duration</div>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small">مؤشر النجاح</span>
                        <div>@Model.SuccessIndicator</div>
                    </div>
                    <div class="mb-0">
                        <span class="text-muted small">الأثر المتوقع</span>
                        <div>@Model.ExpectedImpact</div>
                    </div>
                    <div class="mt-3">
                        <span class="badge bg-warning text-dark px-3 py-2">@Model.Status</span>
                    </div>
                </div>

                <div class="p-4 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                    <h6 class="fw-bold mb-3"><i class="bi bi-shield-check"></i> قرار رئيس اللجنة</h6>
                    <p class="small text-muted mb-3">يمكن اعتماد التوصية مع تحديد أماكن ظهورها لاحقًا، أو إرجاعها للمراجعة مع ملاحظة توضيحية.</p>

                    <form method="post" asp-action="ApproveRecommendation">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reportId" value="@(report?.Id ?? 0)" />

                        <div class="mb-3">
                            <label class="form-label fw-bold small">ملاحظات رئيس اللجنة</label>
                            <textarea name="chairReviewNotes" class="form-control" rows="3" placeholder="أضف ملاحظات الاعتماد أو الإرجاع...">@Model.ChairReviewNotes</textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">أين ستظهر هذه التوصية؟</label>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="IncludeInInstitutionalReport" />
                                <label class="form-check-label small fw-bold">التقرير المؤسسي الشهري</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="IncludeInImpactDashboard" />
                                <label class="form-check-label small fw-bold">لوحة الأثر المحقق</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IncludeInExecutiveSummary" />
                                <label class="form-check-label small fw-bold">الملخص التنفيذي</label>
                            </div>
                        </div>

                        <a asp-action="ChairBoard" class="moda-btn moda-btn-outline w-100 mb-2">
                            <i class="bi bi-arrow-right"></i> رجوع للقائمة
                        </a>
                        <button type="submit" class="moda-btn w-100 mb-2" style="background-color: var(--ctp-primary-olive); color: white;">
                            <i class="bi bi-check-circle"></i> اعتماد التوصية
                        </button>
                        <button type="submit" formaction="/Committee/Workspace/RejectRecommendation" class="moda-btn moda-btn-outline text-danger border-danger w-100">
                            <i class="bi bi-x-circle"></i> رفض التوصية وإرجاعها
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
