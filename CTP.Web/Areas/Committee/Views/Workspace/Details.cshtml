@model CTP.Domain.Entities.MonthlyReport
@{
    Layout = "_Layout";
}

<partial name="~/Views/Shared/_EntityDashboardHeader.cshtml" />

<div class="container-fluid mt-4 mb-5">
    <div class="moda-card border-0 shadow-sm p-4">

        <!-- الترويسة -->
        <div class="row border-bottom pb-3 mb-4">
            <div class="col-md-6">
                <h6 class="text-muted mb-1">الجهة المعنية</h6>
                <h4 class="fw-bold" style="color: var(--ctp-primary-olive);">@(Model.Organization?.EntityName)</h4>
            </div>
            <div class="col-md-3">
                <h6 class="text-muted mb-1">اسم التغيير</h6>
                <span class="fw-bold text-dark">@Model.ChangeName</span>
            </div>
            <div class="col-md-3">
                <h6 class="text-muted mb-1">مرحلة التغيير</h6>
                <span class="badge bg-secondary px-3 py-2">@Model.CurrentStage</span>
            </div>
        </div>

        <!-- الملخص والأبعاد -->
        <h6 class="fw-bold mb-3" style="color: var(--ctp-primary-olive);"><i class="bi bi-card-text me-2"></i> ملخص التغيير والأثر</h6>
        <div class="row mb-4 g-3">
            <div class="col-md-12">
                <div class="p-3 bg-light rounded border">
                    <p class="mb-0 text-dark">@(string.IsNullOrEmpty(Model.ChangeSummary) ? "لا يوجد ملخص" : Model.ChangeSummary)</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded border h-100">
                    <h6 class="text-muted fw-bold small">لماذا هذا التغيير مهم؟</h6>
                    <p class="mb-0 small text-dark">@(string.IsNullOrEmpty(Model.WhyImportant) ? "-" : Model.WhyImportant)</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded border h-100">
                    <h6 class="text-muted fw-bold small">ماذا سيتغير؟</h6>
                    <p class="mb-0 small text-dark">@(string.IsNullOrEmpty(Model.WhatWillChange) ? "-" : Model.WhatWillChange)</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded border h-100">
                    <h6 class="text-muted fw-bold small">ماذا لن يتغير؟</h6>
                    <p class="mb-0 small text-dark">@(string.IsNullOrEmpty(Model.WhatWillNotChange) ? "-" : Model.WhatWillNotChange)</p>
                </div>
            </div>
        </div>

        <!-- المؤشرات -->
        <h6 class="fw-bold mb-3 mt-4" style="color: var(--ctp-primary-olive); border-bottom: 2px solid #F1F5F9; padding-bottom: 8px;"><i class="bi bi-speedometer2 me-2"></i> مؤشرات الأداء والجاهزية (ADKAR)</h6>
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2"><span>الوعي (A)</span> <strong>@Model.AdkarAwareness%</strong></div>
                        <div class="d-flex justify-content-between mb-2"><span>الرغبة (D)</span> <strong>@Model.AdkarDesire%</strong></div>
                        <div class="d-flex justify-content-between mb-2"><span>المعرفة (K)</span> <strong>@Model.AdkarKnowledge%</strong></div>
                        <div class="d-flex justify-content-between mb-2"><span>القدرة (A)</span> <strong>@Model.AdkarAbility%</strong></div>
                        <div class="d-flex justify-content-between"><span>التعزيز (R)</span> <strong>@Model.AdkarReinforcement%</strong></div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <div class="row">
                            <div class="col-6">
                                <h2 class="text-primary fw-bold mb-0">@Model.ReadinessScore%</h2>
                                <span class="text-muted small">مؤشر الجاهزية</span>
                            </div>
                            <div class="col-6">
                                <h2 class="text-success fw-bold mb-0">@Model.AdoptionScore%</h2>
                                <span class="text-muted small">مؤشر التبني</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- التحديات والمخاطر -->
        <h6 class="fw-bold mb-3 mt-4" style="color: var(--ctp-primary-olive); border-bottom: 2px solid #F1F5F9; padding-bottom: 8px;"><i class="bi bi-shield-exclamation me-2"></i> التحديات وعوائق التبني</h6>
        <div class="row mb-4 g-3">
            <div class="col-md-6">
                <div class="p-3 bg-white rounded border border-danger-subtle h-100">
                    <h6 class="text-danger fw-bold small">العوائق والتحديات التشغيلية</h6>
                    <p class="mb-0 small">@(string.IsNullOrEmpty(Model.Obstacles) ? "-" : Model.Obstacles)</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 bg-white rounded border border-warning-subtle h-100">
                    <h6 class="text-warning fw-bold small">عوائق التبني للفئات المتأثرة</h6>
                    <p class="mb-0 small">@(string.IsNullOrEmpty(Model.AdoptionBarriers) ? "-" : Model.AdoptionBarriers)</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 bg-white rounded border border-info-subtle h-100">
                    <h6 class="text-info fw-bold small">الدعم المطلوب للجهة</h6>
                    <p class="mb-0 small">@(string.IsNullOrEmpty(Model.RequiredSupport) ? "-" : Model.RequiredSupport)</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 bg-white rounded border border-primary-subtle h-100">
                    <h6 class="text-primary fw-bold small">التوصية الأولية من الجهة</h6>
                    <p class="mb-0 small">@(string.IsNullOrEmpty(Model.InitialRecommendation) ? "-" : Model.InitialRecommendation)</p>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.CommitteeRecommendation))
        {
            <div class="mb-4 p-4 rounded border border-success-subtle" style="background-color: #f0fdf4;">
                <h6 class="fw-bold text-success mb-2"><i class="bi bi-check2-circle me-2"></i> التوصية المعتمدة من اللجنة</h6>
                <p class="mb-0 text-dark">@Model.CommitteeRecommendation</p>
            </div>
        }

        <!-- صندوق القرار (الانتقال للتحليل) -->
        <div class="p-4 rounded text-center mt-5" style="background-color: #FDF9EC; border: 1px solid rgba(201, 162, 39, 0.4);">
            <h5 class="fw-bold text-dark mb-3">هل اكتملت الصورة لديك؟</h5>
            <p class="text-muted mb-4">انتقل الآن لاستخدام أدوات التحليل (What / So What / Now What) وبناء التوصية النهائية.</p>

            <a asp-action="Inbox" class="moda-btn moda-btn-outline me-2">
                <i class="bi bi-arrow-right"></i> عودة للصندوق
            </a>
            <a asp-action="Analyze" asp-route-id="@Model.Id" class="moda-btn moda-btn-gold px-5 py-2 fs-5">
                <i class="bi bi-diagram-2-fill me-2"></i> الانتقال لأدوات التحليل
            </a>
        </div>

    </div>
</div>