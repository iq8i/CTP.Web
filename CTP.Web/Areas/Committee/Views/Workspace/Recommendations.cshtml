@model IEnumerable<CTP.Domain.Entities.Recommendation>
@{
    Layout = "_Layout";
}

<partial name="~/Views/Shared/_EntityDashboardHeader.cshtml" />

<div class="container-fluid mt-4 mb-5">
    <div class="moda-card border-0 shadow-sm">
        <div class="moda-card-header d-flex justify-content-between align-items-center">
            <h5 class="moda-card-title mb-0">
                <i class="bi bi-journal-text me-2 text-warning"></i> سجل التوصيات والقرارات
            </h5>
            <span class="badge bg-primary px-3 py-2">إجمالي السجل: @(Model?.Count() ?? 0)</span>
        </div>
        <div class="moda-card-body p-0">
            <div class="table-responsive">
                <table class="moda-table text-center align-middle mb-0">
                    <thead>
                        <tr>
                            <th>رقم التوصية</th>
                            <th>التقرير المصدر</th>
                            <th>خلاصة التوصية</th>
                            <th>وجهات الظهور</th>
                            <th>تاريخ المراجعة</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var rec in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@rec.RecommendationNumber</td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(rec.SourceReport?.ReportNumber ?? "غير متوفر")
                                        </span>
                                    </td>

                                    <td class="text-start small fw-bold text-primary"
                                        style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                        title="@rec.SuggestedAction">
                                        @rec.SuggestedAction
                                    </td>

                                    <td class="text-start small">
                                        @if (rec.Status.Contains("معتمدة"))
                                        {
                                            <div class="d-flex flex-wrap gap-1 justify-content-center">
                                                @if (rec.IncludeInInstitutionalReport)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border">التقرير الشهري</span>
                                                }
                                                @if (rec.IncludeInImpactDashboard)
                                                {
                                                    <span class="badge bg-success-subtle text-success border">لوحة الأثر</span>
                                                }
                                                @if (rec.IncludeInExecutiveSummary)
                                                {
                                                    <span class="badge bg-warning-subtle text-dark border">الملخص التنفيذي</span>
                                                }
                                                @if (!rec.IncludeInInstitutionalReport && !rec.IncludeInImpactDashboard && !rec.IncludeInExecutiveSummary)
                                                {
                                                    <span class="text-muted">لم يتم تحديد وجهة عرض</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <td class="small text-muted">
                                        @(rec.ReviewedDate?.ToString("yyyy/MM/dd") ?? rec.CreatedDate.ToString("yyyy/MM/dd"))
                                    </td>

                                    <td>
                                        @if (rec.Status.Contains("جاهزة") || rec.Status.Contains("بانتظار"))
                                        {
                                            <span class="badge bg-warning text-dark border px-3 py-2">
                                                <i class="bi bi-hourglass-split me-1"></i> بانتظار اعتماد الرئيس
                                            </span>
                                        }
                                        else if (rec.Status.Contains("معتمدة"))
                                        {
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="bi bi-check-circle-fill me-1"></i> معتمدة
                                            </span>
                                        }
                                        else if (rec.Status.Contains("مرفوضة"))
                                        {
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="bi bi-x-circle-fill me-1"></i> مرفوضة وإرجاعها للمراجعة
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2">@rec.Status</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(rec.ChairReviewNotes))
                                        {
                                            <div class="small text-muted mt-2" title="@rec.ChairReviewNotes">@rec.ChairReviewNotes</div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="py-5 text-muted">
                                    <i class="bi bi-folder2-open fs-2 d-block mb-2"></i>
                                    لا توجد توصيات مسجلة حالياً في النظام.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>