@model CTP.Web.Areas.UnitLeader.Models.ReportDetailsViewModel
@{
    Layout = "_Layout";
}

<partial name="~/Views/Shared/_EntityDashboardHeader.cshtml" />

<div class="container-fluid mt-3 mb-5">
    <div class="moda-card border-0 shadow-sm p-4">

        <div class="row border-bottom pb-3 mb-4">
            <div class="col-md-6">
                <h6 class="text-muted mb-1">اسم التغيير</h6>
                <h4 class="fw-bold" style="color: var(--ctp-primary-olive);">@Model.ChangeName</h4>
            </div>
            <div class="col-md-3">
                <h6 class="text-muted mb-1">المرحلة الحالية</h6>
                <span class="badge bg-secondary px-3 py-2">@Model.CurrentStage</span>
            </div>
            <div class="col-md-3">
                <h6 class="text-muted mb-1">نوع التغيير</h6>
                <span class="fw-bold text-dark">@Model.ChangeType</span>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-12">
                <h6 class="text-muted fw-bold">ملخص التغيير</h6>
                <div class="p-3 bg-light rounded border">
                    @(string.IsNullOrEmpty(Model.ChangeSummary) ? "لا يوجد ملخص" : Model.ChangeSummary)
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body">
                        <h6 class="text-muted fw-bold mb-3"><i class="bi bi-bar-chart-steps"></i> مؤشرات ADKAR</h6>
                        <div class="d-flex justify-content-between mb-2"><span>الوعي (A)</span> <strong>@Model.AdkarAwareness%</strong></div>
                        <div class="d-flex justify-content-between mb-2"><span>الرغبة (D)</span> <strong>@Model.AdkarDesire%</strong></div>
                        <div class="d-flex justify-content-between mb-2"><span>المعرفة (K)</span> <strong>@Model.AdkarKnowledge%</strong></div>
                        <div class="d-flex justify-content-between mb-2"><span>القدرة (A)</span> <strong>@Model.AdkarAbility%</strong></div>
                        <div class="d-flex justify-content-between"><span>التعزيز (R)</span> <strong>@Model.AdkarReinforcement%</strong></div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <h6 class="text-muted fw-bold mb-3">المؤشرات الإجمالية</h6>
                        <div class="row">
                            <div class="col-6">
                                <h2 class="text-primary fw-bold mb-0">@Model.ReadinessScore%</h2>
                                <span class="text-muted small">نسبة الجاهزية</span>
                            </div>
                            <div class="col-6">
                                <h2 class="text-success fw-bold mb-0">@Model.AdoptionScore%</h2>
                                <span class="text-muted small">نسبة التبني</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <h6 class="text-muted fw-bold">العوائق والتحديات</h6>
                <div class="p-3 bg-white rounded border border-danger-subtle h-100">
                    @(string.IsNullOrEmpty(Model.Obstacles) ? "لا توجد تحديات مسجلة" : Model.Obstacles)
                </div>
            </div>
            <div class="col-md-6">
                <h6 class="text-muted fw-bold">التوصية الأولية</h6>
                <div class="p-3 bg-white rounded border border-info-subtle h-100">
                    @(string.IsNullOrEmpty(Model.InitialRecommendation) ? "لا توجد توصيات" : Model.InitialRecommendation)
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.CommitteeRecommendation))
        {
            <div class="row mb-4">
                <div class="col-12">
                    <h6 class="text-muted fw-bold">التوصية المعتمدة من اللجنة</h6>
                    <div class="p-3 bg-light rounded border border-success-subtle">
                        @Model.CommitteeRecommendation
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.EvidenceLinks))
        {
            <div class="row mb-5">
                <div class="col-12">
                    <h6 class="text-muted fw-bold"><i class="bi bi-link-45deg"></i> روابط الشواهد والأدلة</h6>
                    <div class="p-3 bg-light rounded border">
                        <a href="@Model.EvidenceLinks" target="_blank">@Model.EvidenceLinks</a>
                    </div>
                </div>
            </div>
        }

        <!-- صندوق اتخاذ القرار -->
        <div class="p-4 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
            <h6 class="fw-bold mb-3"><i class="bi bi-shield-check"></i> اتخاذ القرار</h6>
            <form method="post" asp-action="Review" class="row gx-3 align-items-center">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="col-md-8">
                    <input type="text" name="notes" class="form-control" placeholder="أضف ملاحظات توجيهية للسفير أو للجنة (اختياري)..." />
                </div>

                <div class="col-md-4 d-flex gap-2 justify-content-end">
                    <button type="submit" name="isApproved" value="false" class="moda-btn moda-btn-outline text-danger border-danger">
                        <i class="bi bi-x-circle"></i> إعادة للسفير
                    </button>
                    <button type="submit" name="isApproved" value="true" class="moda-btn" style="background-color: var(--ctp-primary-olive); color: white;">
                        <i class="bi bi-check-circle"></i> اعتماد وإرسال للجنة
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>