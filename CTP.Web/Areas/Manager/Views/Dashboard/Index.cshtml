@model CTP.Web.Areas.Manager.Models.ManagerDashboardViewModel
@{
    Layout = "_Layout";
}

@section Styles {
    <style>
        .hero-banner {
            background: linear-gradient(135deg, #0B4F61, #2E86A0);
            color: white;
            padding: 32px 36px;
            border-radius: 18px;
            margin-bottom: 24px;
            box-shadow: 0 15px 40px rgba(11, 79, 97, 0.25);
        }

        .hero-banner h1 { font-size: 1.8rem; font-weight: 800; margin-bottom: 8px; }
        .hero-banner .hero-sub { opacity: 0.9; font-size: 1rem; margin-bottom: 20px; }

        .hero-stats {
            display: flex;
            gap: 32px;
            flex-wrap: wrap;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
        }

        .hero-stat { display: flex; align-items: center; gap: 12px; }

        .hero-stat .hero-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: #E6D39A;
        }

        .hero-stat .hero-num { font-size: 1.6rem; font-weight: 800; line-height: 1.1; }
        .hero-stat .hero-lbl { font-size: 0.75rem; opacity: 0.8; }

        .role-card {
            background: #FFFFFF;
            border: 1px solid #D6E5EA;
            border-radius: 14px;
            padding: 20px;
            height: 100%;
            text-align: center;
        }

        .role-card .role-icon {
            width: 56px;
            height: 56px;
            margin: 0 auto 14px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
        }

        .role-card h6 { font-weight: 800; color: #073B49; margin-bottom: 8px; }
        .role-card p { font-size: 0.85rem; color: #537382; line-height: 1.6; margin-bottom: 0; }

        .tool-card {
            background: #FFFFFF;
            border: 1px solid #D6E5EA;
            border-radius: 14px;
            padding: 18px;
            height: 100%;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .tool-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(46, 134, 160, 0.18);
            border-color: #2E86A0;
            color: inherit;
        }

        .change-mini {
            border-right: 3px solid #C9A227;
            background: #FDF9EC;
            border-radius: 8px;
            padding: 10px 14px;
            margin-bottom: 8px;
        }

        .change-mini .chg-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: #073B49;
        }

        .change-mini .chg-meta {
            font-size: 0.72rem;
            color: #537382;
            margin-top: 4px;
        }
    </style>
}

<partial name="~/Views/Shared/_EntityDashboardHeader.cshtml" />

<div class="container-fluid mt-4 mb-5">

    <div class="hero-banner">
        <h1>مرحباً أيها القائد</h1>
        <p class="hero-sub">دورك الأقرب للمنسوبين — كن نقطة الدعم الأولى خلال التغيير</p>

        <div class="hero-stats">
            <div class="hero-stat">
                <div class="hero-icon"><i class="bi bi-people"></i></div>
                <div>
                    <div class="hero-num">@Model.TeamSize</div>
                    <div class="hero-lbl">فريقك</div>
                </div>
            </div>
            <div class="hero-stat">
                <div class="hero-icon"><i class="bi bi-kanban"></i></div>
                <div>
                    <div class="hero-num">@Model.ActiveChangesCount</div>
                    <div class="hero-lbl">تغيير جارٍ</div>
                </div>
            </div>
            <div class="hero-stat">
                <div class="hero-icon"><i class="bi bi-book"></i></div>
                <div>
                    <div class="hero-num">@Model.MaterialsCount</div>
                    <div class="hero-lbl">مادة تعليمية</div>
                </div>
            </div>
        </div>
    </div>

    <!-- دورك في التغيير -->
    <h5 class="fw-bold mb-3" style="color: var(--ctp-primary-olive);">
        <i class="bi bi-person-check me-2"></i> دورك في التغيير
    </h5>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="role-card">
                <div class="role-icon" style="background: #EAF2F4; color: #106981;">
                    <i class="bi bi-chat-square-text"></i>
                </div>
                <h6>اشرح التغيير لفريقك</h6>
                <p>بلغة بسيطة وداعمة. استخدم بطاقات التغييرات الجارية كمرجع.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="role-card">
                <div class="role-icon" style="background: #FDF7E3; color: #8A6A12;">
                    <i class="bi bi-hand-thumbs-up"></i>
                </div>
                <h6>ادعم جاهزيتهم</h6>
                <p>ساندهم في التطبيق، وافهم احتياجاتهم، وذلّل العقبات اليومية.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="role-card">
                <div class="role-icon" style="background: #F0FDF4; color: #3E7C3E;">
                    <i class="bi bi-arrow-up-circle"></i>
                </div>
                <h6>ارصد وارفع</h6>
                <p>شارك التحديات والملاحظات مع سفير التغيير في جهتك.</p>
            </div>
        </div>
    </div>

    <!-- Row 2: أدوات الدعم + التغييرات -->
    <div class="row g-4">

        <!-- أدوات الدعم -->
        <div class="col-lg-5">
            <div class="moda-card border-0 shadow-sm p-4 h-100">
                <h6 class="fw-bold mb-3" style="color: var(--ctp-primary-olive);">
                    <i class="bi bi-tools me-2"></i> أدواتك للدعم
                </h6>

                @foreach (var tool in Model.SupportTools)
                {
                    <a href="@tool.Url" class="tool-card mb-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width: 44px; height: 44px; background: var(--bs-@tool.Color)-bg-subtle; color: var(--bs-@tool.Color);">
                                <i class="bi @tool.Icon fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold" style="color: #073B49; font-size: 0.9rem;">@tool.Title</div>
                                <div class="small text-muted mt-1">@tool.Description</div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>

        <!-- التغييرات في نطاق الفريق -->
        <div class="col-lg-7">
            <div class="moda-card border-0 shadow-sm p-4 h-100">
                <h6 class="fw-bold mb-3" style="color: var(--ctp-primary-olive);">
                    <i class="bi bi-kanban me-2"></i> التغييرات في نطاق فريقك
                </h6>

                @if (Model.TeamChanges.Any())
                {
                    foreach (var change in Model.TeamChanges)
                    {
                        <div class="change-mini">
                            <div class="chg-title">@change.ChangeName</div>
                            <div class="chg-meta">
                                <i class="bi bi-building me-1"></i>@change.EntityName
                                <span class="mx-2">|</span>
                                <i class="bi bi-signpost me-1"></i>@change.CurrentStage
                                <span class="mx-2">|</span>
                                <i class="bi bi-diagram-3 me-1"></i>@change.ChangeType
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <small>لا توجد تغييرات معتمدة حالياً</small>
                    </div>
                }

                <div class="alert alert-info small border-0 mt-3 mb-0" style="background: #F8FAFC;">
                    <i class="bi bi-info-circle me-1"></i>
                    لمزيد من التفاصيل، تفضل بزيارة <a asp-area="Staff" asp-controller="Dashboard" asp-action="Changes" class="text-decoration-underline">صفحة التغييرات الجارية</a>.
                </div>
            </div>
        </div>
    </div>

</div>